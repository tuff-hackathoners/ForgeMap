generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id            String   @id // proj_<uuid>
  name          String
  idea          String
  budgetTarget  Float?   @map("budget_target")
  budgetActual  Float?   @map("budget_actual")
  skillLevel    String?  @map("skill_level")
  aiData        String?  @map("ai_data") // JSON: assemblyDrawing, materials, tools, instructions, overview
  createdAt     DateTime @default(now()) @map("created_at")

  commits      Commit[]
  roadmapTasks RoadmapTask[]

  @@map("projects")
}

model Commit {
  id              String   @id // commit_<uuid>
  projectId       String   @map("project_id")
  timestamp       DateTime @default(now())
  mediaUrl        String?  @map("media_url")
  userNote        String?  @map("user_note")
  detectedChanges String?  @map("detected_changes") // JSON string
  projectState    String?  @map("project_state")     // JSON string
  completedTasks  String?  @map("completed_tasks")   // JSON string
  feedback        String?  @map("feedback")          // JSON string: { overallAssessment, issues, positiveNotes, alignmentScore }
  roadmapState    String?  @map("roadmap_state")     // JSON string

  project Project @relation(fields: [projectId], references: [id])

  @@map("commits")
}

model RoadmapTask {
  id           String @id // task_<uuid>
  projectId    String @map("project_id")
  title        String
  description  String @default("")
  status       String @default("not_started") // not_started | in_progress | completed | blocked
  dependencies String @default("[]") @map("dependencies") // JSON array of task IDs
  order        Int    @default(0)
  metadata     String? @map("metadata") // JSON: visualGuide, tips, openscadCode, svgProfile

  project Project @relation(fields: [projectId], references: [id])

  @@map("roadmap_tasks")
}
